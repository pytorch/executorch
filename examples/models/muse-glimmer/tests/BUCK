oncall("executorch")

if is_fbcode():
    cpp_unittest(
        name = "cuda_dflash_executor_test",
        srcs = ["cuda_dflash_executor_test.cpp"],
        deps = ["//executorch/examples/models/muse-glimmer/runtime:cuda_dflash_executor"],
        external_deps = ["nlohmann_json"],
    )

