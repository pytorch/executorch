    name = "dflash_speculative_verifier_test",
    srcs = ["test_dflash_speculative_verifier.py"],
    deps = [
        "//caffe2:torch",
        "//executorch/examples/models/muse-glimmer/model:dflash_token_sampler",
    ],
)

fbcode_target(
    _kind = python_unittest,
    name = "dflash_token_sampler_test",
