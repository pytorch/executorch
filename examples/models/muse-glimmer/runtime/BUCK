        "//executorch/runtime/backend:interface",
    ],
    exported_deps = [
        ":muse_glimmer_batching_preparation",
        "fbsource//third-party/nlohmann-json:nlohmann-json",
        "//executorch/backends/cuda/batching:cuda_executor",
        "//executorch/extension/llm/batching:batching",
        "//executorch/extension/llm/batching:executor_utils",
        "//executorch/extension/llm/cache:kv_cache",
        "//executorch/extension/llm/serving:serving_runtime",
        "//executorch/extension/module:module",
        "//executorch/extension/tensor:tensor",
    ],
    external_deps = [("cuda", None, "cuda-lazy"), "nlohmann_json"],
)

