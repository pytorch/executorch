+Error CudaKVPool::ensure_sequence_memory_pool() {
+#if !defined(EXECUTORCH_USE_HIP)
+  if (sequence_memory_pool_ != nullptr) {
+    return Error::Ok;
+  }
+  cudaMemPoolProps props{};
+  props.allocType = cudaMemAllocationTypePinned;
+  props.handleTypes = cudaMemHandleTypeNone;
+  props.location.type = cudaMemLocationTypeDevice;
+  props.location.id = device_;
+  cudaMemPool_t pool = nullptr;
+  if (cudaMemPoolCreate(&pool, &props) != cudaSuccess) {
+    (void)cudaGetLastError();
+    return Error::MemoryAllocationFailed;
+  }
+  uint64_t threshold = std::numeric_limits<uint64_t>::max();
+  if (cudaMemPoolSetAttribute(pool, cudaMemPoolAttrReleaseThreshold,
+                              &threshold) != cudaSuccess) {
+    (void)cudaMemPoolDestroy(pool);
+    (void)cudaGetLastError();
+    return Error::Internal;
+  }
+  auto& registry = sequence_memory_pools();
+  {
+    const std::lock_guard<std::mutex> lock(registry.mutex);
+    registry.devices.emplace(pool, device_);
+  }
+  sequence_memory_pool_ = pool;
+#endif
+  return Error::Ok;
+}
+
+void CudaKVPool::trim_sequence_memory_pool() {
+#if !defined(EXECUTORCH_USE_HIP)
+  if (sequence_memory_pool_ == nullptr) {
+    return;
+  }
+  // Called only after the migration fence has observed every copy and free.
+  // This pool has no model workspace or graph allocation to evict.
+  uint64_t used = 0, reserved = 0;
+  if (cudaMemPoolGetAttribute(sequence_memory_pool_,
+          cudaMemPoolAttrUsedMemCurrent, &used) != cudaSuccess ||
+      cudaMemPoolGetAttribute(sequence_memory_pool_,
+          cudaMemPoolAttrReservedMemCurrent, &reserved) != cudaSuccess ||
+      (reserved > used &&
+       cudaMemPoolTrimTo(sequence_memory_pool_, used) != cudaSuccess)) {
+    ET_LOG(Error, "offgraph_kv: private sequence pool trim failed");
+    (void)cudaGetLastError();
+  }
+#endif
+}
+
+CudaKVPool::SequenceMemoryStatistics
+CudaKVPool::sequence_memory_pool_statistics(int device) {
+  SequenceMemoryStatistics stats;
+#if !defined(EXECUTORCH_USE_HIP)
+  auto& registry = sequence_memory_pools();
+  const std::lock_guard<std::mutex> lock(registry.mutex);
+  for (const auto& entry : registry.devices) {
+    if (entry.second != device) {
+      continue;
+    }
+    stats.available = true;
+    uint64_t values[4] = {};
+    const cudaMemPoolAttr attributes[] = {cudaMemPoolAttrUsedMemCurrent,
+        cudaMemPoolAttrReservedMemCurrent, cudaMemPoolAttrUsedMemHigh,
+        cudaMemPoolAttrReservedMemHigh};
+    bool ok = true;
+    for (size_t index = 0; index < 4; ++index) {
+      if (cudaMemPoolGetAttribute(entry.first, attributes[index],
+                                  &values[index]) != cudaSuccess) {
+        (void)cudaGetLastError();
+        ok = false;
+      }
+    }
+    stats.query_ok &= ok;
+    if (ok) {
+      stats.used_bytes += values[0];
+      stats.reserved_bytes += values[1];
+      // The sum of component highs is an upper bound, not a sampled peak.
+      stats.used_high_bytes += values[2];
+      stats.reserved_high_bytes += values[3];
+    }
+  }
+#else
+  (void)device;
+#endif
+  return stats;
+}
