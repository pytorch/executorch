diff --git a/examples/models/muse-glimmer/tests/runtime_kv_columns_probe.cpp b/examples/models/muse-glimmer/tests/runtime_kv_columns_probe.cpp
new file mode 100644
--- /dev/null
+++ b/examples/models/muse-glimmer/tests/runtime_kv_columns_probe.cpp
@@ -0,0 +1,289 @@
+/*
