menu "Camera inference stream"

    config CAMERA_STREAM_MODEL
        string "ExecuTorch program (.pte) to embed; absolute or relative to this project"
        default "models/mobilenet_v3_small_224.pte"


    choice CAMERA_STREAM_PINOUT
        prompt "Camera module pinout"
        default CAMERA_STREAM_PINOUT_S3_EYE

        config CAMERA_STREAM_PINOUT_S3_EYE
            bool "ESP32-S3-EYE, Freenove ESP32-S3-WROOM CAM, ESP32-S3-CAM N16R8"

        config CAMERA_STREAM_PINOUT_XIAO_SENSE
            bool "Seeed XIAO ESP32S3 Sense"
    endchoice

    config CAMERA_STREAM_SENSOR_JPEG
        bool "Capture JPEG from the sensor (decode on the ESP32 for inference)"
        default y
        help
            JPEG frames are about 15 times smaller than RGB565, so the camera
            DMA does not compete with inference for PSRAM bandwidth and the
            preview needs no software encoder. Turn off to capture RGB565.

    config CAMERA_STREAM_SENSOR_JPEG_QUALITY
        int "Sensor JPEG quality (0 to 63, lower is better)"
        range 4 63
        default 12
        depends on CAMERA_STREAM_SENSOR_JPEG

    config CAMERA_STREAM_XCLK_MHZ
        int "Camera XCLK frequency in MHz"
        range 6 24
        default 10
        help
            At 20 MHz an OV3660 on the ESP32-S3 CAM boards drops and corrupts
            frames after a while (NO-SOI, frame timeouts, dark frames).
            10 MHz is stable and still gives a 12 fps preview.

    config CAMERA_STREAM_PREVIEW
        bool "Stream JPEG preview frames alongside the results"
        default y

    config CAMERA_STREAM_PREVIEW_QUALITY
        int "Preview JPEG quality (1 to 100, higher is better)"
        range 1 100
        default 50
        depends on CAMERA_STREAM_PREVIEW

    config CAMERA_STREAM_PREVIEW_MAX_FPS
        int "Preview frame rate limit"
        range 1 60
        default 15
        depends on CAMERA_STREAM_PREVIEW

    config CAMERA_STREAM_VFLIP
        bool "Flip the image vertically"
        default n

    config CAMERA_STREAM_HMIRROR
        bool "Mirror the image horizontally"
        default n

endmenu
