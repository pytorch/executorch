load("@fbcode_macros//build_defs:build_file_migration.bzl", "fbcode_target", "non_fbcode_target")
load("@fbcode_macros//build_defs:python_unittest.bzl", "python_unittest")
# Any targets that should be shared between fbcode and xplat must be defined in
# targets.bzl. This file can contain fbcode-only targets.

load("@fbsource//xplat/executorch/build:runtime_wrapper.bzl", "runtime")

oncall("executorch")

fbcode_target(_kind = runtime.python_library,
    name = "lfm3",
    srcs = [
        "convert_weights.py",
        "model_wrapper.py",
    ],
    base_module = "executorch.examples.qualcomm.oss_scripts.lfm3",
    visibility = ["PUBLIC"],
    deps = [
        "//caffe2:torch",
        "//executorch/examples/qualcomm/oss_scripts/llama:masking_utils",
        "//executorch/examples/qualcomm/oss_scripts/llama:static_llama",
        "fbsource//third-party/pypi/safetensors:safetensors",
    ],
)

fbcode_target(_kind = python_unittest,
    name = "test_lfm3_static",
    srcs = [
        "test_lfm3_static.py",
    ],
    base_module = "executorch.examples.qualcomm.oss_scripts.lfm3",
    deps = [
        ":lfm3",
        "//caffe2:torch",
        "//executorch/backends/qualcomm/_passes:passes",
        "//executorch/backends/qualcomm/builders:builders",
        "//executorch/backends/qualcomm/quantizer:quantizer",
    ],
)
