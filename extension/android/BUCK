load("@fbcode_macros//build_defs:build_file_migration.bzl", "fbcode_target", "non_fbcode_target")
load("@fbsource//tools/build_defs/android:fb_android_library.bzl", "fb_android_library")

oncall("executorch")

# NOTE: the platform-neutral sources live in the shared source directory
# extension/java/src/main/java and are consumed here as filegroup labels
# exported from extension/java/BUCK, so the Android targets keep their
# historical names, ownership, and attributes (required_for_source_only_abi,
# pure_kotlin, deps) while compiling the exact same classes as before the
# move. Log.kt is the Android-backed implementation of the
# org.pytorch.executorch.Log facade that the shared sources reference.
#
# MAINTENANCE: both Gradle (java.srcDirs glob) and the filegroups in
# extension/java/BUCK (glob) pick up new shared sources automatically, so no
# per-file lists need updating. The ASR and image-processing sources are
# intentionally Gradle-only (as before this change); add Buck targets for them
# when an internal build needs them.

non_fbcode_target(_kind = fb_android_library,
    name = "executorch",
    warnings_as_errors = False,
    required_for_source_only_abi = True,
    srcs = [
        "executorch_android/src/main/java/org/pytorch/executorch/Log.kt",
        "//xplat/executorch/extension/java:core_sources",
    ],
    autoglob = False,
    language = "KOTLIN",
    pure_kotlin = False,
    extra_kotlinc_arguments = ["-Xjvm-default=all"],
    deps = [
        "//fbandroid/java/com/facebook/jni:jni",
        "//fbandroid/libraries/soloader/java/com/facebook/soloader/nativeloader:nativeloader",
    ] + ([
        "//xplat/executorch/backends/vulkan:vulkan_backend_lib_static",
    ] if read_config("executorch", "minimal_jni", "false") == "false" else []),
)

non_fbcode_target(_kind = fb_android_library,
    name = "executorch_training",
    warnings_as_errors = False,
    srcs = [
        "//xplat/executorch/extension/java:training_sources",
    ],
    autoglob = False,
    language = "KOTLIN",
    deps = [
        ":executorch",
        "//fbandroid/java/com/facebook/jni:jni",
        "//fbandroid/libraries/soloader/java/com/facebook/soloader/nativeloader:nativeloader",
    ],
)

non_fbcode_target(_kind = fb_android_library,
    name = "executorch_llama",
    warnings_as_errors = False,
    srcs = [
        "//xplat/executorch/extension/java:llm_sources",
    ],
    autoglob = False,
    language = "KOTLIN",
    extra_kotlinc_arguments = ["-Xjvm-default=all"],
    deps = [
        ":executorch",
        "//fbandroid/java/com/facebook/jni:jni",
        "//fbandroid/libraries/soloader/java/com/facebook/soloader/nativeloader:nativeloader",
    ],
)
