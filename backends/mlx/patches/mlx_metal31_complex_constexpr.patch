Keep runtime JIT sources compatible with older Metal frontends.

MLX supports macOS 14 and selects Metal language 3.1 there. Changes in v0.32.1
introduced several constructs which are accepted by newer Metal frontends but
rejected by the Xcode 15.4 runtime compiler. Because these headers are embedded
in runtime-JIT sources, the incompatibilities prevent unrelated kernels from
compiling as well.

Keep the modern generic complex implementation intact. Give its layout checks
diagnostic messages, retain the half and bfloat16 arithmetic probes on Metal
3.2+, and use the existing static constexpr form for its Limits members. Also
use remove_addrspace_t only on Metal 4.1+, where explicit thread qualifiers made
it necessary and the trait is available; older language versions retain the
previous decltype behavior.

Upstream candidate; carried locally until MLX includes the compatibility fixes.

diff --git a/mlx/backend/metal/kernels/complex.h b/mlx/backend/metal/kernels/complex.h
index fe78e005..f558b10a 100644
--- a/mlx/backend/metal/kernels/complex.h
+++ b/mlx/backend/metal/kernels/complex.h
@@ -154,9 +154,15 @@ struct complex_t {
 using complex32_t = complex_t<half>;
 using complex64_t = complex_t<float>;
 
-static_assert(sizeof(complex32_t) == 2 * sizeof(half));
-static_assert(sizeof(complex64_t) == 2 * sizeof(float));
-static_assert(sizeof(complex_t<bfloat16_t>) == 2 * sizeof(bfloat16_t));
+static_assert(
+    sizeof(complex32_t) == 2 * sizeof(half),
+    "complex32_t must contain exactly two half lanes");
+static_assert(
+    sizeof(complex64_t) == 2 * sizeof(float),
+    "complex64_t must contain exactly two float lanes");
+static_assert(
+    sizeof(complex_t<bfloat16_t>) == 2 * sizeof(bfloat16_t),
+    "complex bfloat16 must contain exactly two bfloat16 lanes");
 
 template <typename T>
 constexpr complex_t<T> operator-(complex_t<T> x) {
@@ -295,9 +301,14 @@ constexpr complex_t<T> operator%(complex_t<T> a, complex_t<T> b) {
   return {real, imag};
 }
 
+// Metal 3.1 cannot constant-evaluate half and bfloat16 arithmetic.
+#if __METAL_VERSION__ >= 320
 static_assert(
-    (complex_t<half>{1.0h, 2.0h} * complex_t<half>{3.0h, 4.0h}).real == -5.0h);
+    (complex_t<half>{1.0h, 2.0h} * complex_t<half>{3.0h, 4.0h}).real == -5.0h,
+    "half complex multiplication must preserve lane precision");
 static_assert(
     (complex_t<bfloat16_t>{bfloat16_t(1.0f), bfloat16_t(2.0f)} *
      complex_t<bfloat16_t>{bfloat16_t(3.0f), bfloat16_t(4.0f)})
-        .real == bfloat16_t(-5.0f));
+        .real == bfloat16_t(-5.0f),
+    "bfloat16 complex multiplication must preserve lane precision");
+#endif
diff --git a/mlx/backend/metal/kernels/steel/utils/integral_constant.h b/mlx/backend/metal/kernels/steel/utils/integral_constant.h
index 2f153f48..65e555b9 100644
--- a/mlx/backend/metal/kernels/steel/utils/integral_constant.h
+++ b/mlx/backend/metal/kernels/steel/utils/integral_constant.h
@@ -47,12 +47,18 @@ using Int = integral_constant<int, val>;
 // Binary Operators on Integral constants
 ///////////////////////////////////////////////////////////////////////////////
 
+#if __METAL_VERSION__ >= 410
+#define MLX_REMOVE_ADDRSPACE(T) metal::remove_addrspace_t<T>
+#else
+#define MLX_REMOVE_ADDRSPACE(T) T
+#endif
+
 #define integral_const_binop(__op__, __operator__)          \
   template <typename T, T tv, typename U, U uv>             \
   METAL_FUNC constexpr auto __operator__(                   \
       integral_constant<T, tv>, integral_constant<U, uv>) { \
     constexpr auto res = tv __op__ uv;                      \
-    using res_t = metal::remove_addrspace_t<decltype(res)>; \
+    using res_t = MLX_REMOVE_ADDRSPACE(decltype(res));       \
     return integral_constant<res_t, res>{};                 \
   }
 
@@ -110,6 +116,7 @@ constexpr void const_for_loop(F f) {
 }
 
 #undef integral_const_binop
+#undef MLX_REMOVE_ADDRSPACE
 
 ///////////////////////////////////////////////////////////////////////////////
 // Reduction operators
diff --git a/mlx/backend/metal/kernels/utils.h b/mlx/backend/metal/kernels/utils.h
index f1592828..46462399 100644
--- a/mlx/backend/metal/kernels/utils.h
+++ b/mlx/backend/metal/kernels/utils.h
@@ -78,9 +78,9 @@
 template <typename T>
 struct Limits<complex_t<T>> {
-  inline static constexpr constant complex_t<T> max = complex_t<T>(
+  static constexpr constant complex_t<T> max = complex_t<T>(
       metal::numeric_limits<T>::infinity(),
       metal::numeric_limits<T>::infinity());
-  inline static constexpr constant complex_t<T> min = complex_t<T>(
+  static constexpr constant complex_t<T> min = complex_t<T>(
       -metal::numeric_limits<T>::infinity(),
       -metal::numeric_limits<T>::infinity());
 };
