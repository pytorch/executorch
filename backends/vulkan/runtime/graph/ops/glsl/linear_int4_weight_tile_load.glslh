#ifndef LINEAR_INT4_WEIGHT_TILE_LOAD_GLSLH
#define LINEAR_INT4_WEIGHT_TILE_LOAD_GLSLH

/*
 * Assumes the following variables are declared in shader layout:
 * - t_packed_int4_weight
 *
 * Macro Settings:
 * - WEIGHT_BUFFER
 */

#extension GL_EXT_control_flow_attributes : require

#include "linear_int4_weight_tile.glslh"

// Packed int4 weight blocks are stored [k4][n8], so that threads owning
// adjacent n8 read adjacent blocks.
ivec4 load_int4_weight_block(const int k4, const int n8, const int N8) {
#ifdef WEIGHT_BUFFER
  return t_packed_int4_weight[k4 * N8 + n8];
#else
  return texelFetch(t_packed_int4_weight, ivec2(n8, k4), 0);
#endif
}

void load_int4_weight_tile(
    out Int4WeightTile weight_tile,
    const int k4_start,
    const int n8_start,
    const int N8) {
  [[unroll]] for (int k4 = 0; k4 < TILE_K4; ++k4) {
    [[unroll]] for (int n8 = 0; n8 < TILE_N8; ++n8) {
      weight_tile.data[k4][n8] =
          load_int4_weight_block(k4_start + k4, n8_start + n8, N8);
    }
  }
}

#endif // LINEAR_INT4_WEIGHT_TILE_LOAD_GLSLH
