menu "ExecuTorch ESP-NN backend"

    config ESPNN_EXECUTORCH_DELEGATE
        bool "Build the ExecuTorch delegate (EspNNBackend) and link the ExecuTorch runtime"
        default n
        help
            Needs ExecuTorch cross-compiled for this chip, see
            examples/espressif/scripts/build_executorch_esp.sh. Without it the
            component still provides the standalone XTS3 int8 interpreter.

    config ESPNN_DELEGATE_CONSTANTS_TO_PSRAM
        bool "Copy delegate weights from flash into PSRAM when they fit"
        default y
        depends on ESPNN_EXECUTORCH_DELEGATE && SPIRAM

    config ESPNN_DELEGATE_DUAL_CORE
        bool "Split ESP-NN kernels across both cores inside delegates"
        default n
        depends on ESPNN_EXECUTORCH_DELEGATE

    config ESPNN_DELEGATE_PROFILE
        bool "Print a per-operator profile after each delegate's first run"
        default n
        depends on ESPNN_EXECUTORCH_DELEGATE

endmenu
