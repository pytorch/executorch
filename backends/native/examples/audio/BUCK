load("@fbcode_macros//build_defs:build_file_migration.bzl", "fbcode_target")
load("@fbsource//xplat/executorch/build:runtime_wrapper.bzl", "runtime")

oncall("executorch")

fbcode_target(
    _kind = runtime.python_library,
    name = "hf_whisper",
    srcs = ["export_hf_whisper.py"],
    visibility = ["//executorch/backends/native/test/..."],
    deps = [
        "//caffe2:torch",
        "//executorch/backends/native/examples/hf_llm:hf_utils",
        "//executorch/exir:lib",
        "//executorch/exir/native:native",
        "fbsource//third-party/pypi/transformers:transformers",
    ],
)

fbcode_target(
    _kind = runtime.python_binary,
    name = "export_hf_whisper",
    main_function = "executorch.backends.native.examples.audio.export_hf_whisper.main",
    deps = [
        ":hf_whisper",
        "fbsource//third-party/pypi/safetensors:safetensors",
    ],
)

runtime.cxx_library(
    name = "whisper_runner",
    srcs = ["WhisperRunner.cpp"],
    exported_headers = ["WhisperRunner.h"],
    deps = [
        "//executorch/backends/native/examples/runner_utils:runner_utils",
        "//executorch/backends/native/runtime:runtime",
        "//executorch/backends/native/runtime/deserialize:package",
        "//executorch/backends/native/runtime/graph:scalar_type",
    ],
    exported_deps = ["//executorch/backends/native/runtime/engine:engine"],
    external_deps = ["gflags"],
    visibility = ["PUBLIC"],
)

fbcode_target(
    _kind = runtime.cxx_binary,
    name = "run_whisper_ggml_cpu",
    srcs = ["run_whisper_ggml_cpu.cpp"],
    deps = [
        ":whisper_runner",
        "//executorch/backends/native/runtime/engine:ggml_engine_cpu",
    ],
    external_deps = ["gflags"],
    visibility = ["PUBLIC"],
)
