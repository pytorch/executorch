        "//executorch/exir/native:native",
        "//executorch/extension/llm/export:load",
        "fbsource//third-party/pypi/safetensors:safetensors",
        "fbsource//third-party/pypi/transformers:transformers",
        "//pytorch/ao:torchao",
    ],
)

fbcode_target(
    _kind = runtime.python_binary,
    name = "export_hf_llm",
    main_function = "executorch.backends.native.examples.hf.export_hf_llm.main",
    deps = [":export_hf_llm_lib"],
)

