load("@fbcode_macros//build_defs:build_file_migration.bzl", "fbcode_target")
load("@fbsource//xplat/executorch/build:runtime_wrapper.bzl", "runtime")

oncall("executorch")

fbcode_target(
    _kind = runtime.python_library,
    name = "record",
    srcs = [
        "cases.py",
        "linear.py",
        "ops.py",
        "record.py",
        "schemes.py",
    ],
    deps = [
        "//caffe2:torch",
        "//executorch/backends/test/suite/operators:test_operators",
        "//executorch/exir/native:native",
        "//pytorch/ao:torchao",
    ],
)

fbcode_target(
    _kind = runtime.python_binary,
    name = "generate",
    srcs = ["generate.py"],
    main_function = "executorch.backends.native.test.samples.generate.main",
    deps = [":record"],
)

fbcode_target(
    _kind = runtime.python_test,
    name = "test_record",
    srcs = ["test_record.py"],
    deps = [
        ":record",
        "//caffe2:torch",
        "//executorch/exir/native:native",
    ],
)

# Op packages with bundled samples, one per op and quantization scheme.
fbcode_target(
    _kind = runtime.genrule,
    name = "op_samples",
    out = "op_samples",
    cmd = "$(exe :generate) --out $OUT",
    visibility = ["//executorch/backends/native/test/..."],
)
